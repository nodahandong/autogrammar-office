<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>5b0c6f0e-9a51-4d8e-b3a7-2f6d1c9e4a21</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>AutoGrammar</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="AutoGrammar"/>
  <Description DefaultValue="Select text in an email and fix, rewrite or translate it (any language) with ChatGPT."/>
  <IconUrl DefaultValue="https://nodahandong.github.io/autogrammar-office/assets/icon64.png"/>
  <HighResolutionIconUrl DefaultValue="https://nodahandong.github.io/autogrammar-office/assets/icon128.png"/>
  <SupportUrl DefaultValue="https://nodahandong.github.io/autogrammar-office/taskpane.html"/>
  <AppDomains>
    <AppDomain>https://nodahandong.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://nodahandong.github.io/autogrammar-office/read.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://nodahandong.github.io/autogrammar-office/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="AGGroupRead">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="AGReadButton">
                  <Label resid="Read.Label"/>
                  <Supertip>
                    <Title resid="Read.Label"/>
                    <Description resid="Read.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Read.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="AGGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="AGFixButton">
                  <Label resid="Fix.Label"/>
                  <Supertip>
                    <Title resid="Fix.Label"/>
                    <Description resid="Fix.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>fixGrammar</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="AGPaneButton">
                  <Label resid="Pane.Label"/>
                  <Supertip>
                    <Title resid="Pane.Label"/>
                    <Description resid="Pane.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="AGGroupAppt">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="AGFixButtonAppt">
                  <Label resid="Fix.Label"/>
                  <Supertip>
                    <Title resid="Fix.Label"/>
                    <Description resid="Fix.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>fixGrammar</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://nodahandong.github.io/autogrammar-office/assets/icon16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://nodahandong.github.io/autogrammar-office/assets/icon32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://nodahandong.github.io/autogrammar-office/assets/icon80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://nodahandong.github.io/autogrammar-office/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://nodahandong.github.io/autogrammar-office/taskpane.html"/>
        <bt:Url id="Read.Url" DefaultValue="https://nodahandong.github.io/autogrammar-office/read.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="AutoGrammar"/>
        <bt:String id="Fix.Label" DefaultValue="Fix grammar"/>
        <bt:String id="Pane.Label" DefaultValue="AutoGrammar"/>
        <bt:String id="Read.Label" DefaultValue="Translate"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Fix.Tooltip" DefaultValue="Select text in your email, then click to fix its grammar (any language)."/>
        <bt:String id="Read.Tooltip" DefaultValue="Translate this email to English, Korean, Khmer or another language to read it."/>
        <bt:String id="Pane.Tooltip" DefaultValue="Open AutoGrammar to see changes and change settings (API key, model)."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
